# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (consumed by the compose `postgres` service) ------------------
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=coach_memory

# --- DSN the `mcp` service uses to reach Postgres ---------------------------
# Host is the compose service name `postgres` on the internal network.
# Must match POSTGRES_* above.
DATABASE_URL=postgresql://coach:change-me-to-a-strong-password@postgres:5432/coach_memory

# --- Auth -------------------------------------------------------------------
# AUTH_ENABLED=true  → every /mcp request must carry the bearer token below
#                      (checked by the ASGI middleware).
# AUTH_ENABLED=false → "network-only" mode: the middleware is not installed and
#                      requests pass through unauthenticated. Defence then relies
#                      on the reverse-proxy IP allowlist + TLS + an unguessable
#                      URL. No OAuth flow is ever advertised in either mode.
AUTH_ENABLED=true
# Bearer token (min 16 chars) — REQUIRED only when AUTH_ENABLED=true.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# --- Optional ---------------------------------------------------------------
LOG_LEVEL=INFO
# HOST / PORT / MCP_PATH have sensible defaults (0.0.0.0 / 8000 / /mcp).
# MIGRATIONS_DIR is set to /app/migrations inside the image; no need to set here.
